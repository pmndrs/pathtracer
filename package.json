{
  "name": "pathtracer-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "bluenoise:generate": "node packages/raytracer/tools/bluenoise/generate.ts",
    "bluenoise:report": "node packages/raytracer/tools/bluenoise/report.ts",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "release": "pnpm build && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "24.19.2",
    "@webgpu/types": "^0.1.64",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
