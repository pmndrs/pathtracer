{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "sourceMap": false,
    "types": ["@webgpu/types"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.testutil.ts", "node_modules", "dist"]
}
